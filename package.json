{
  "name": "seep-node-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "migrate:branch-admins": "node scripts/migrate-branch-admins.js --apply",
    "inventory:check": "node scripts/migrate-inventory.js --check",
    "inventory:migrate": "node scripts/migrate-inventory.js --apply",
    "inventory:barcode:remove:check": "node scripts/migrate-inventory-remove-barcode.js --check",
    "inventory:barcode:remove": "node scripts/migrate-inventory-remove-barcode.js --apply",
    "inventory:import:preview": "node scripts/import-inventory-workbook.js",
    "inventory:controls:check": "node scripts/migrate-inventory-controls.js --check",
    "inventory:controls:migrate": "node scripts/migrate-inventory-controls.js --apply",
    "inventory:controls:seed-demo": "node scripts/seed-inventory-controls-demo.js",
    "inventory:alerts:check": "node scripts/migrate-inventory-alerts.js --check",
    "inventory:alerts:migrate": "node scripts/migrate-inventory-alerts.js --apply",
    "inventory:alerts:sync": "node scripts/sync-inventory-alerts.js",
    "inventory:purchasing:check": "node scripts/migrate-inventory-purchasing.js --check",
    "inventory:purchasing:migrate": "node scripts/migrate-inventory-purchasing.js --apply",
    "inventory:purchasing:seed-demo": "node scripts/seed-inventory-purchasing-demo.js",
    "inventory:counts:check": "node scripts/migrate-inventory-cycle-counts.js --check",
    "inventory:counts:migrate": "node scripts/migrate-inventory-cycle-counts.js --apply",
    "inventory:counts:weekly:preview": "node scripts/generate-weekly-cycle-counts.js",
    "inventory:counts:weekly": "node scripts/generate-weekly-cycle-counts.js --apply",
    "inventory:quality": "node scripts/inventory-data-quality.js",
    "inventory:status": "node scripts/inventory-status.js",
    "inventory:reorder:preview": "node scripts/generate-reorder-drafts.js",
    "inventory:reorder:drafts": "node scripts/generate-reorder-drafts.js --apply",
    "inventory:media:preview": "node scripts/cleanup-inventory-media.js",
    "inventory:media:cleanup": "node scripts/cleanup-inventory-media.js --apply",
    "inventory:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-inventory.ps1",
    "inventory:tasks:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-inventory-tasks.ps1",
    "inventory:uat": "node scripts/run-inventory-uat.js",
    "inventory:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-inventory-acceptance.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
