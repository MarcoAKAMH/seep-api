NODE_ENV=production
PORT=3001
TRUST_PROXY=1
CORS_ORIGIN=https://seeptaller.com,https://www.seeptaller.com

DB_HOST=REEMPLAZAR_ENDPOINT_LIGHTSAIL
DB_PORT=3306
DB_USER=REEMPLAZAR_USUARIO
DB_PASSWORD=REEMPLAZAR_CONTRASENA
DB_NAME=seep_taller
DB_POOL_LIMIT=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=/home/ubuntu/certs/global-bundle.pem

JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_BYTES
JWT_EXPIRES_IN=10m
REFRESH_COOKIE_NAME=seep_rt
REFRESH_DAYS_REMEMBER=30
REFRESH_DAYS_SESSION=1
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

INVENTORY_PHOTO_DIR=/var/lib/seep/inventory-photos
INVENTORY_COUNT_EVIDENCE_DIR=/var/lib/seep/inventory-count-evidence
INVENTORY_WEEKLY_COUNT_SIZE=10
INVENTORY_WEEKLY_COUNT_ZONE=TODAS
INVENTORY_ORPHAN_MEDIA_DAYS=30
INVENTORY_EVIDENCE_RETENTION_DAYS=365
INVENTORY_BACKUP_DIR=/var/backups/seep/inventory
INVENTORY_BACKUP_RETENTION_DAYS=30
